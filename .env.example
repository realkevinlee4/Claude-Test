# News API Configuration
NEWSAPI_KEY=your_newsapi_key_here

# Twitter/X API Configuration (Optional - requires Twitter Developer Account)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API Configuration (Optional)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=DailyNewsAggregator/1.0

# ProPublica Congress API (Free - get key from https://www.propublica.org/datastore/api/propublica-congress-api)
PROPUBLICA_API_KEY=your_propublica_api_key_here

# Timezone Configuration
TZ=America/New_York

# Report Storage
REPORTS_DIR=./reports
DATABASE_PATH=./data/news.db

# Scheduling (leave as default for 8AM-6PM EST hourly, 9AM overnight summary)
HOURLY_SCHEDULE=0 8-18 * * *
OVERNIGHT_SUMMARY_SCHEDULE=0 9 * * *
