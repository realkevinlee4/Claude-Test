# Daily News Aggregator - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# REQUIRED API KEYS (Get at least one of these)
# ============================================

# NewsAPI (Required) - Get free at https://newsapi.org/register
# Free tier: 100 requests/day
NEWSAPI_KEY=your_newsapi_key_here

# ProPublica Congress API (Required) - Get free at https://www.propublica.org/datastore/api/propublica-congress-api
# Completely free, no rate limits
PROPUBLICA_API_KEY=your_propublica_key_here


# ============================================
# OPTIONAL API KEYS (Recommended but not required)
# ============================================

# Twitter/X Bearer Token (Optional) - Get at https://developer.twitter.com/
# Requires developer account approval
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API (Optional) - Create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=DailyNewsAggregator/1.0


# ============================================
# SYSTEM CONFIGURATION
# ============================================

# Timezone (EST/EDT)
TZ=America/New_York

# Reports directory (where generated reports are saved)
REPORTS_DIR=./reports

# Database file path
DATABASE_PATH=./data/news.db


# ============================================
# SCHEDULING (Optional - defaults shown)
# ============================================

# Hourly updates schedule (cron format)
# Default: Every hour from 8 AM to 6 PM EST
HOURLY_SCHEDULE=0 8-18 * * *

# Overnight summary schedule (cron format)
# Default: Every day at 9:00 AM EST
OVERNIGHT_SUMMARY_SCHEDULE=0 9 * * *


# ============================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================

# Enable/disable email notifications
EMAIL_ENABLED=false

# Email recipients (comma-separated)
EMAIL_RECIPIENTS=your.email@example.com,another@example.com

# Send hourly email updates (default: false - only overnight summaries)
SEND_HOURLY_EMAILS=false

# Send overnight summary emails (default: true)
SEND_OVERNIGHT_EMAIL=true


# ============================================
# SMTP SETTINGS (Required if EMAIL_ENABLED=true)
# ============================================

# SMTP Server Settings
# For Gmail: smtp.gmail.com (port 587)
# For Outlook: smtp-mail.outlook.com (port 587)
# For Yahoo: smtp.mail.yahoo.com (port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication
# For Gmail: Use your email and an App Password (not your regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_app_password_here


# ============================================
# WEB SERVER (Optional)
# ============================================

# Port for web interface (default: 3000)
# PORT=3000
